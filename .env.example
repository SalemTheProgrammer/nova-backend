# Application
APP_NAME=nova-agent-backend
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Security
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Comma-separated list of valid API keys for the X-API-Key header
API_KEYS=dev-local-key

# OpenAI / LLM
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-5.4-nano
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=text-embedding-3-small

# Pinecone
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=nova-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBEDDING_DIMENSION=1536

# Agent
AGENT_MAX_ITERATIONS=8
AGENT_RECURSION_LIMIT=25
RETRIEVAL_TOP_K=4

# Voix (OpenAI audio)
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Vision : analyse des photos envoyées à Nova sur WhatsApp (contrôle qualité)
VISION_MODEL=gpt-4o-mini

# Superviseur autonome + simulation
SUPERVISOR_ENABLED=true
AUTO_SIM_AUTOSTART=false
# Nova proactive : les propositions du superviseur partent aussi par WhatsApp
# vers ces numéros (CSV) — l'opérateur répond oui/non depuis son téléphone.
SUPERVISOR_NOTIFY_NUMBERS=
SUPERVISOR_NOTIFY_CRITICAL_ONLY=true

# Notifications sortantes (envoyer_rapport / envoyer_message)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WHATSAPP_SERVICE_URL=http://localhost:3001

# WhatsApp entrant : écrire au numéro WhatsApp de Nova pour parler à l'agent.
# Liste blanche CSV de numéros autorisés ; vide = tout numéro accepté (démo).
WHATSAPP_INBOUND_ENABLED=true
WHATSAPP_ALLOWED_NUMBERS=

# Bilan automatique (envoi périodique sans opérateur, désactivé par défaut)
AUTO_BILAN_ENABLED=false
AUTO_BILAN_CANAL=email
AUTO_BILAN_DESTINATAIRE=
AUTO_BILAN_HEURES=06:00,14:00,22:00
