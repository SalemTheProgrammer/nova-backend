# Référence complète : app/core/config.py (source de vérité des valeurs par défaut).

# Application
APP_NAME=nova-agent-backend
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./nova.db
# Base neuve (aucune migration, tables créées au démarrage) ; ne pas réutiliser une ancienne base SQLite.
# Production (MariaDB) : base `nova` et utilisateur `nova_app` créés par docs/tunicotex/provision.sql
# DATABASE_URL=mysql+pymysql://nova_app:<mot_de_passe>@127.0.0.1:3306/nova?charset=utf8mb4
# Historique des conversations (SQLite) ; vide = à côté de la base SQLite, sinon ./data/nova_chat_history.db
CHAT_HISTORY_DB_PATH=

# Sécurité
# Origines CORS autorisées (CSV)
CORS_ORIGINS=http://localhost:5173
# Clés acceptées dans l'en-tête X-API-Key (CSV) — vide = contrôle désactivé
API_KEYS=dev-local-key
# Signe les jetons de session : chaîne longue et aléatoire, à changer impérativement
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_TTL_S=604800
VERIFICATION_CODE_TTL_S=300
# Numéro administrateur (E.164) créé au démarrage — OBLIGATOIRE pour se connecter
ADMIN_PHONE=

# OpenAI / LLM
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-5.4-nano
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=text-embedding-3-small
AGENT_RECURSION_LIMIT=25

# Voix (OpenAI audio)
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Vision : analyse des photos envoyées à Nova sur WhatsApp (contrôle qualité)
VISION_MODEL=gpt-4o-mini

# Base documentaire (RAG)
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=nova-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBEDDING_DIMENSION=1536
DOCUMENTS_PDF_DIR=./data/documents

# Notifications sortantes (envoyer_message / envoyer_document)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WHATSAPP_SERVICE_URL=http://localhost:3001

# WhatsApp entrant : écrire au numéro WhatsApp de Nova pour parler à l'agent.
# Liste blanche des numéros NON enregistrés comme utilisateurs (CSV).
# Vide = tout numéro inconnu est refusé. Un numéro listé mais non enregistré
# n'obtient que les outils de lecture (jamais d'envoi ni de planification).
WHATSAPP_INBOUND_ENABLED=true
WHATSAPP_ALLOWED_NUMBERS=

# Bilan automatique (envoi périodique sans opérateur, désactivé par défaut)
AUTO_BILAN_ENABLED=false
AUTO_BILAN_CANAL=email
AUTO_BILAN_DESTINATAIRE=
AUTO_BILAN_HEURES=07:30
# R1 à R4 (R1 = fiche de production journalière)
AUTO_BILAN_RAPPORT=R1

# Divatex : base DIVA du client (lecture seule, compte MariaDB SELECT uniquement)
# Exemple : mysql+pymysql://nova_ro:<mot_de_passe>@127.0.0.1:3306/divatex?charset=utf8mb4
DIVATEX_URL=
DIVATEX_STATEMENT_TIMEOUT_S=15
DIVATEX_CACHE_TTL_S=60
# auto = dernier jour avec une sortie confection (14 derniers jours, repli : dernière date lue) ; today = aujourd'hui ; ou AAAA-MM-JJ
DIVATEX_DATE_REFERENCE=auto
# provisoire : "Temps" DIVA semble déjà en minutes — à confirmer à la calibration
DIVATEX_TEMPS_FACTEUR=1.0
# Majoration multiplie les minutes produites
DIVATEX_APPLIQUER_MAJORATION=true
# Présence supposée (min) quand la table presence n'a pas de ligne
DIVATEX_DUREE_POSTE_MIN=480
# Phase finale pour les retards et commandes à risque (SORTIE STIRO)
DIVATEX_PHASE_FINALE=12
# true retire la mention "(estimé)" : seulement après calibration (docs/tunicotex/calibration.md)
DIVATEX_CALIBRE=false
