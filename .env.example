# Référence complète : app/core/config.py (source de vérité des valeurs par défaut).

# Application
APP_NAME=nova-agent-backend
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./nova.db

# Sécurité
# Origines CORS autorisées (CSV)
CORS_ORIGINS=http://localhost:5173
# Clés acceptées dans l'en-tête X-API-Key (CSV) — vide = contrôle désactivé
API_KEYS=dev-local-key
# Signe les jetons de session : chaîne longue et aléatoire, à changer impérativement
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_TTL_S=604800
VERIFICATION_CODE_TTL_S=300
# Numéro administrateur (E.164) créé au démarrage — OBLIGATOIRE pour se connecter
ADMIN_PHONE=

# OpenAI / LLM
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-5.4-nano
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=text-embedding-3-small
AGENT_RECURSION_LIMIT=25

# Voix (OpenAI audio)
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Vision : analyse des photos envoyées à Nova sur WhatsApp (contrôle qualité)
VISION_MODEL=gpt-4o-mini

# Base documentaire (RAG)
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=nova-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBEDDING_DIMENSION=1536
DOCUMENTS_PDF_DIR=./data/documents

# MQTT / Sparkplug B — télémétrie et commandes des automates
# Nova est l'hôte Sparkplug du groupe SPARKPLUG_GROUP_ID sur ce broker.
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TLS_CA_FILE=
MQTT_CLIENT_ID=nova-mes
MQTT_KEEPALIVE_S=30
SPARKPLUG_GROUP_ID=NovaPlant
SPARKPLUG_HOST_ID=nova-mes
SPARKPLUG_REBIRTH_MIN_INTERVAL_S=10
# Attente maximale de l'accusé d'un automate après une commande (s)
MACHINE_COMMAND_TIMEOUT_S=5

# Superviseur autonome
SUPERVISOR_ENABLED=true
# manuel | assiste | autopilote (modifiable à chaud : POST /api/v1/agent/autonomie)
AUTONOMY_MODE_DEFAUT=manuel
AUTOPILOTE_DELAI_MOYEN_S=45
# Nova proactive : propositions du superviseur envoyées par WhatsApp (CSV)
SUPERVISOR_NOTIFY_NUMBERS=
SUPERVISOR_NOTIFY_CRITICAL_ONLY=false

# Notifications sortantes (envoyer_rapport / envoyer_message)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WHATSAPP_SERVICE_URL=http://localhost:3001

# WhatsApp entrant : écrire au numéro WhatsApp de Nova pour parler à l'agent.
# Liste blanche des numéros NON enregistrés comme utilisateurs (CSV).
# Vide = tout numéro inconnu accepté AVEC TOUS LES OUTILS — à renseigner hors démo.
WHATSAPP_INBOUND_ENABLED=true
WHATSAPP_ALLOWED_NUMBERS=

# Bilan automatique (envoi périodique sans opérateur, désactivé par défaut)
AUTO_BILAN_ENABLED=false
AUTO_BILAN_CANAL=email
AUTO_BILAN_DESTINATAIRE=
AUTO_BILAN_HEURES=06:00,14:00,22:00
